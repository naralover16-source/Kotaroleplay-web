})();

function save(){
 const warga=Array.isArray(db.warga)?db.warga:[];
 const base={...db,warga:[]};
 const rawBase=JSON.stringify(base);
 try{
  localStorage.setItem(KEY,rawBase);
  const chunkSize=350000;
  const count=Math.ceil(warga.length/chunkSize);
  for(let i=0;i<count;i++)localStorage.setItem(KEY+'_w_'+i,JSON.stringify(warga.slice(i*chunkSize,(i+1)*chunkSize)));
  const oldCount=Number(localStorage.getItem(KEY+'_w_count')||0);
  for(let i=count;i<oldCount;i++)localStorage.removeItem(KEY+'_w_'+i);
  localStorage.setItem(KEY+'_w_count',String(count));
 }catch(e){
  try{localStorage.setItem(KEY,JSON.stringify(db));localStorage.removeItem(KEY+'_w_count')}catch(err){console.warn('Penyimpanan lokal penuh:',err)}
 }
 updateAll()
}
