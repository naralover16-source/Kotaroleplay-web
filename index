function removeCategory(type,cat){
 const base=Array.isArray(instansiCategories[type])?instansiCategories[type]:[];
 if(base.includes(cat)){alert('Kategori bawaan tidak dapat dihapus. Anda dapat memindahkan data dengan Edit.');return}
 if(!confirm(`Hapus kategori "${cat}"? Data di kategori ini akan dipindahkan ke kategori pertama.`))return;
 const fallback=getCategories(type).find(c=>c!==cat)||'Umum';db[type].forEach(x=>{if(x.kategori===cat)x.kategori=fallback});
 db._customCategories[type]=(db._customCategories[type]||[]).filter(c=>c!==cat);save();openCategoryManager(type);toast('Kategori dihapus dan data dipindahkan.');
}

