function previewDokFile(e){
 const f=e.target.files?.[0];if(!f)return;
 if(!f.type.startsWith('image/')){alert('File harus berupa gambar.');e.target.value='';return}
 if(f.size>5*1024*1024){alert('Ukuran foto maksimal 5 MB.');e.target.value='';return}
 const r=new FileReader();r.onload=()=>{window._pendingDocPhoto=r.result;document.getElementById('dkPreview').innerHTML=`<img class="doc-preview" src="${r.result}" alt="Pratinjau dokumen">`};r.readAsDataURL(f);
}
function previewDokDataFile(e){
 const f=e.target.files?.[0];if(!f)return;
 if(f.size>2*1024*1024){alert('Ukuran data maksimal 2 MB.');e.target.value='';return}
 const r=new FileReader();
 r.onload=()=>{try{
   const d=JSON.parse(r.result);
   const get=(...keys)=>{for(const k of keys){if(d[k]!==undefined&&d[k]!==null)return d[k]}return ''};
   const set=(id,val)=>{const el=document.getElementById(id);if(el&&val!==undefined&&val!==null)el.value=String(val)};
   set('dkNo',get('no','nomorDokumen','nomor'));
   set('dkJenis',get('jenis','jenisDokumen'));
   set('dkPemilik',get('pemilik','nama','namaPemilik'));
   set('dkTerbit',get('terbit','tanggalTerbit'));
   set('dkStatus',get('status'));
   if(typeof d.foto==='string'&&d.foto.startsWith('data:image/')){window._pendingDocPhoto=d.foto;const p=document.getElementById('dkPreview');if(p)p.innerHTML=`<img class="doc-preview" src="${d.foto}" alt="Pratinjau dokumen">`}
   toast('Data dokumen berhasil dimuat ke formulir.');
 }catch(err){alert('File data tidak valid. Gunakan format JSON.')}e.target.value=''};
 r.readAsText(f);
}
