function saveAttachedDocPhoto(id){const x=db.dok.find(d=>d.id===id);if(!x?.foto){alert('Belum ada foto dokumen yang dilampirkan.');return}const filename=(x.jenis||'Dokumen-RP').replace(/[^a-z0-9_-]+/gi,'-')+'-'+(x.no||Date.now())+'.png';try{const base=x.foto.split(',')[1]||'';const mime=(x.foto.match(/^data:([^;]+);/)||[])[1]||'image/png';const bin=atob(base);const arr=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)arr[i]=bin.charCodeAt(i);const blob=new Blob([arr],{type:mime});const file=new File([blob],filename,{type:mime});if(navigator.share&&navigator.canShare&&navigator.canShare({files:[file]})){navigator.share({files:[file],title:x.jenis||'Dokumen RP',text:'Foto dokumen Roleplay'}).then(()=>toast('Foto dokumen siap disimpan ke galeri.')).catch(e=>{if(e&&e.name!=='AbortError')downloadAttachedDocPhoto(blob,filename)})}else downloadAttachedDocPhoto(blob,filename)}catch(e){alert('Foto dokumen tidak dapat disimpan di browser ini.')}}
function downloadAttachedDocPhoto(blob,filename){const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=filename;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);toast('Foto dokumen berhasil dibuat. Simpan file tersebut ke Galeri.')}
function viewDocPhoto(id){const x=db.dok.find(d=>d.id===id);if(x?.foto)openModal('Foto Dokumen',`<img class="doc-preview" src="${x.foto}" alt="Foto dokumen"><div class="muted" style="margin-top:8px">${esc(x.jenis)} • ${esc(x.no)} • ${esc(x.pemilik)}</div><div class="actions"><button type="button" class="btn secondary" data-action="close">Tutup</button><button type="button" class="btn" onclick="saveAttachedDocPhoto(${x.id})">📸 Simpan Foto</button></div>`)}
