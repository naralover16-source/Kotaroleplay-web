function saveInstansi(type,id){
 const c=instansiConfig[type];const existing=(db[type]||[]).find(v=>v.id===id)||{};
 const x={...existing,id:id||nextId(type),kategori:document.getElementById('if_kategori')?.value||existing.kategori||getCategories(type)[0]||'Umum'};
 c.fields.forEach(f=>{const el=document.getElementById('if_'+f[0]);if(el)x[f[0]]=el.value.trim()});
 const first=c.fields[0]?.[0],second=c.fields[1]?.[0];
 if(!x[first]||!x[second]){alert('Data utama wajib diisi.');return}
 x.favorite=!!document.getElementById('if_favorite')?.checked;
 ['lokasi','koordinat','kontak','rating','komentar','notifikasi','pengumuman','statistik','jamOperasional','jadwal','formulir'].forEach(k=>{
   const el=document.getElementById('if_'+k);if(el)x[k]=el.value;
 });
 if(type==='pemesanan'){
   x.nomorResep=document.getElementById('if_nomorResep')?.value.trim()||'';
   x.detailResep=document.getElementById('if_detailResep')?.value||'';
   x.instruksiResep=document.getElementById('if_instruksiResep')?.value||'';
 }
 // Simpan seluruh field khusus kategori yang sedang dipilih.
 categorySpecificFields(type,x.kategori).forEach(f=>{const el=document.getElementById('if_'+f[0]);if(el)x[f[0]]=el.value.trim()});
 const now=new Date().toLocaleString('id-ID');
 const previous=x.riwayat||'';
 x.riwayat=(previous?previous+'\n':'')+(id?`[${now}] Data diperbarui`:`[${now}] Data dibuat`);
 const photo=document.getElementById('if_fotoData');
 const doc=document.getElementById('if_dokumenData');
 const readFile=(el,key)=>new Promise(resolve=>{
   if(!el?.files?.[0])return resolve();
   const file=el.files[0],r=new FileReader();
   r.onload=()=>{x[key]=r.result;x[key+'Name']=file.name;x[key+'Type']=file.type;resolve()};
   r.onerror=()=>resolve();r.readAsDataURL(file);
 });
 Promise.all([readFile(photo,'fotoData'),readFile(doc,'dokumenData')]).then(()=>{
   if(id)db[type]=db[type].map(v=>v.id===id?x:v);else db[type].push(x);
   save();closeModal();toast(`${c.title}: seluruh isi data berhasil ${id?'diperbarui':'ditambahkan'}.`);
 });
}

