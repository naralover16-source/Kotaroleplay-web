function getCategories(type){
 const base=Array.isArray(instansiCategories[type])?instansiCategories[type]:['Umum'];
 const custom=(db._customCategories&&Array.isArray(db._customCategories[type]))?db._customCategories[type]:[];
 return [...new Set([...base,...custom])];
}
function migrateInstansiCategories(){
 db._customCategories=db._customCategories&&typeof db._customCategories==='object'?db._customCategories:{};
 Object.keys(instansiConfig).forEach(type=>{
  if(!Array.isArray(db[type]))db[type]=[];
  const cats=getCategories(type); const fallback=cats[0]||'Umum';
  db[type].forEach(x=>{if(!x.kategori)x.kategori=fallback;});
 });
}
