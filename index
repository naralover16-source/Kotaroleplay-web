/* Registry resep RP: lookup hanya mengambil data resep yang memang tersimpan. */
function findResepByNomor(no){const key=String(no||'').trim().toLowerCase();return db.resep.find(r=>String(r.nomor||'').trim().toLowerCase()===key)||null}
function resepLookupHtml(x){
 const no=x?.nomorResep||'';
 return `<div class="feature-panel" style="margin-top:12px"><h3>💊 Data Resep & Pemesanan Obat</h3>
 <div class="form-grid">
  <div class="field"><label>Nomor Resep</label><input class="input" id="if_nomorResep" value="${esc(no)}" placeholder="Masukkan nomor resep yang tersimpan"></div>
  <div class="field" style="display:flex;align-items:end"><button type="button" class="btn secondary" id="btnLookupResep">🔎 Cari Resep</button></div>
  <div class="field full"><label>Obat / Barang yang tercatat pada resep</label><textarea class="input" id="if_detailResep" readonly>${esc(x?.detailResep||'')}</textarea><div class="muted" style="margin-top:6px">Sistem hanya menampilkan isi resep yang sudah tersimpan dengan nomor tersebut.</div></div>
  <div class="field full"><label>Instruksi penggunaan yang tercatat</label><textarea class="input" id="if_instruksiResep" readonly>${esc(x?.instruksiResep||'')}</textarea></div>
 </div></div>`;
}
function bindResepLookup(){
 const btn=document.getElementById('btnLookupResep'),inp=document.getElementById('if_nomorResep');
 if(!btn||!inp)return;
 const run=()=>{
   const r=findResepByNomor(inp.value);
   const d=document.getElementById('if_detailResep'),i=document.getElementById('if_instruksiResep');
   if(r){if(d)d.value=r.detail||'';if(i)i.value=r.instruksi||'';toast('Resep ditemukan dan datanya ditampilkan.');}
   else{if(d)d.value='';if(i)i.value='';toast('Nomor resep tidak ditemukan pada data tersimpan.');}
 };
 rpOn(btn,'click',run);
 rpOn(inp,'change',run);
}
function openResepCreator(){
 openModal('🧾 Pembuatan Resep Obat',`<div class="notice">Form ini menyimpan resep untuk kebutuhan simulasi RP. Masukkan obat dan instruksi persis seperti data yang ingin dicatat; sistem tidak menentukan dosis medis.</div>
 <div class="form-grid">
  <div class="field"><label>Nomor Resep</label><input class="input" id="rxNomor" placeholder="Contoh: RX-RP-000001"></div>
  <div class="field"><label>Nama Pasien</label><input class="input" id="rxPasien"></div>
  <div class="field"><label>NIK Pasien</label><input class="input" id="rxNik"></div>
  <div class="field"><label>Dokter / Pemberi Resep</label><input class="input" id="rxDokter"></div>
  <div class="field full"><label>Obat yang tercatat</label><textarea class="input" id="rxDetail" placeholder="Tuliskan daftar obat sesuai resep yang diterbitkan."></textarea></div>
  <div class="field full"><label>Instruksi yang tercatat</label><textarea class="input" id="rxInstruksi" placeholder="Tuliskan instruksi persis seperti pada resep."></textarea></div>
 </div>
 <div class="actions"><button type="button" class="btn secondary" data-action="close">Batal</button><button type="button" class="btn" id="saveResepBtn">💾 Simpan Resep</button></div>`);
 rpOn(document.getElementById('saveResepBtn'),'click',()=>{
   const nomor=document.getElementById('rxNomor').value.trim();
   const detail=document.getElementById('rxDetail').value.trim();
   if(!nomor||!detail){alert('Nomor resep dan daftar obat wajib diisi.');return}
   const data={id:nextId('resep'),nomor,pasien:document.getElementById('rxPasien').value.trim(),nik:document.getElementById('rxNik').value.trim(),dokter:document.getElementById('rxDokter').value.trim(),detail,instruksi:document.getElementById('rxInstruksi').value.trim(),dibuat:new Date().toLocaleString('id-ID')};
   const old=findResepByNomor(nomor);
   if(old)db.resep=db.resep.map(r=>r.id===old.id?{...old,...data,id:old.id}:r);else db.resep.push(data);
   save();closeModal();toast('Data resep berhasil disimpan untuk kebutuhan RP.');
 });
}

