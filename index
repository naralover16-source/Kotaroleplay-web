function filterInstansiCategories(){
 const q=(document.getElementById('searchKategoriInstansi')?.value||'').trim().toLowerCase();
 const grid=document.getElementById('instansiCategoryGrid');
 const results=document.getElementById('instansiCategorySearchResults');
 if(!grid||!results)return;
 [...grid.querySelectorAll('.instansi-card')].forEach(card=>{card.style.display=(!q||card.textContent.toLowerCase().includes(q))?'':'none'});
 const matches=INSTANSI_CATEGORY_SEARCH_DATA.filter(x=>!q||`${x[2]} ${x[3]}`.toLowerCase().includes(q));
 results.innerHTML=matches.map(x=>`<button type="button" class="btn secondary category-search-item" onclick="go('${x[0]}')"><span style="font-size:20px">${x[1]}</span><span><b>${esc(x[2])}</b><small class="muted" style="display:block">${esc(x[3])}</small></span></button>`).join('');
}

function openCommandCenter(){
 const keys=Object.keys(instansiConfig),total=keys.reduce((a,k)=>a+(db[k]?.length||0),0);
 const cards=keys.slice(0,4).map(k=>`<div class="command-stat"><span class="muted">${instansiConfig[k].title}</span><b>${db[k]?.length||0}</b><small class="muted">data tercatat</small></div>`).join('');
 const all=keys.flatMap(k=>(db[k]||[]).map(x=>({...x,_type:k}))).sort((a,b)=>Number(b.id)-Number(a.id)).slice(0,20);
 const rows=all.length?all.map(x=>`<tr><td>${instansiConfig[x._type].icon} ${instansiConfig[x._type].title}</td><td>${esc(x.nomor||x.idpersonel||x.id||'-')}</td><td>${esc(x.pasien||x.terlapor||x.terdakwa||x.pemohon||x.nama||x.pelapor||'-')}</td><td><span class="badge">${esc(x.status||'Aktif')}</span></td></tr>`).join(''):`<tr><td colspan="4" class="muted">Belum ada aktivitas instansi.</td></tr>`;
 openModal('📡 Command Center',`<div class="command-grid">${cards}<div class="command-stat"><span class="muted">Total Data Instansi</span><b>${total}</b><small class="muted">lintas layanan</small></div></div><div class="notice">Command Center menampilkan ringkasan administratif. Detail data tetap dikelola dari modul instansi masing-masing.</div><div class="instansi-table-wrap" style="margin-top:12px"><table class="instansi-table"><thead><tr><th>Instansi</th><th>Nomor/ID</th><th>Subjek</th><th>Status</th></tr></thead><tbody>${rows}</tbody></table></div><div class="actions"><button type="button" class="btn secondary" data-action="close">Tutup</button></div>`);
}

function del(type,id){
 if(!confirm('Hapus data ini?'))return;
