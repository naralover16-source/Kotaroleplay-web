body{min-height:100vh;line-height:1.45;overflow-x:hidden;background:radial-gradient(circle at 15% -5%,rgba(25,217,255,.12),transparent 30%),radial-gradient(circle at 90% 10%,rgba(108,124,255,.10),transparent 28%),linear-gradient(180deg,#070b10 0%,#0a1016 48%,#070b10 100%)}
body:before{opacity:.018;background-size:24px 24px}
.sidebar{width:268px;padding:18px 13px;background:linear-gradient(180deg,rgba(5,9,13,.98),rgba(9,16,23,.98));border-right:1px solid rgba(80,103,120,.3);box-shadow:18px 0 45px rgba(0,0,0,.3);overflow-y:auto;scrollbar-width:thin}
.brand{padding:8px 10px 22px;margin-bottom:8px;border-bottom:1px solid rgba(255,255,255,.06)}
.logo{width:46px;height:46px;border-radius:13px;background:linear-gradient(135deg,var(--primary),#4b78ff);box-shadow:0 0 28px rgba(25,217,255,.22);border:1px solid rgba(255,255,255,.35)}
.brand b{font-size:14px}.brand small{font-size:10px}
.nav{padding-top:5px}.nav button{min-height:43px;padding:10px 12px;margin:3px 0;border-radius:10px;gap:11px;color:#a9bac7}.nav button:hover,.nav button.active{background:linear-gradient(90deg,rgba(25,217,255,.13),rgba(108,124,255,.05));border-color:rgba(25,217,255,.22);box-shadow:inset 3px 0 0 var(--primary),0 5px 18px rgba(0,0,0,.14)}
.main{margin-left:268px;width:calc(100% - 268px);max-width:1800px;padding:28px 30px 42px}
.top{position:sticky;top:0;z-index:8;padding:13px 0 16px;margin:-8px 0 18px;background:linear-gradient(180deg,rgba(7,11,16,.96) 70%,rgba(7,11,16,0));backdrop-filter:blur(8px)}
.top h1{font-size:24px;letter-spacing:.7px}.top p{font-size:12px}.user{border-radius:12px;background:rgba(16,23,32,.9);padding:9px 13px}
.cards{gap:14px}.card{border-radius:var(--radius);padding:18px;background:linear-gradient(145deg,rgba(16,23,32,.96),rgba(11,16,22,.96));box-shadow:var(--shadow),inset 0 1px rgba(255,255,255,.025)}
.card:hover{border-color:rgba(25,217,255,.22)}.stat .num{font-size:27px}.icon{border-radius:12px}
.section{margin-top:22px}.section-head{gap:12px;margin-bottom:13px}.section-head h2{font-size:17px}
.btn{min-height:39px;padding:9px 14px;border-radius:10px}.btn.small{min-height:32px;border-radius:8px}.toolbar{gap:10px;margin-bottom:14px}.input,select,textarea{min-height:41px;padding:10px 12px;border-radius:10px;background:rgba(10,16,22,.94);border-color:#2a3a48}.input:focus,select:focus,textarea:focus{box-shadow:0 0 0 3px rgba(25,217,255,.07),0 0 18px rgba(25,217,255,.08)}
.table-wrap,.master-editor{border-radius:13px;box-shadow:0 10px 28px rgba(0,0,0,.16)}.table th,.table td{padding:11px 13px}.table th{background:#131c25}.table tr:hover td{background:rgba(25,217,255,.035)}
.grid2,.form-grid{gap:14px}.field label{margin-bottom:7px;color:#a9bac7}.notice{border-radius:11px}.member-item{border-radius:10px}.actions{gap:9px}
.modal{padding:20px;background:rgba(1,4,7,.78)}.modal-box{width:min(820px,96vw);border-radius:18px;padding:22px;background:linear-gradient(145deg,#111922,#0b1117);border-color:#2c3c49;box-shadow:0 24px 80px rgba(0,0,0,.45)}.modal-head{padding-bottom:12px;border-bottom:1px solid rgba(255,255,255,.06)}
.login-box{border-radius:20px;padding:30px;background:linear-gradient(145deg,#111a23,#0b1117);box-shadow:0 25px 90px rgba(0,0,0,.5);border-color:#30404d}.login-box .input{background:#0b1219}
.toast{right:24px;bottom:24px;border-radius:12px;padding:12px 16px;box-shadow:0 12px 35px rgba(0,0,0,.35)}
.instansi-hero,.order-hero{border-radius:18px;padding:22px;box-shadow:var(--shadow);background:linear-gradient(135deg,rgba(25,217,255,.08),rgba(108,124,255,.07) 55%,rgba(255,179,0,.035))}.instansi-hero h2,.order-hero h2{line-height:1.2}.instansi-badge{border-radius:999px}
.gov-portal{border-radius:16px}.gov-portal .gov-head{padding:20px 22px}.gov-menu{gap:11px}.gov-menu .gov-action{border-radius:11px;padding:11px 13px}
.instansi-grid{gap:13px}.instansi-card{border-radius:15px;padding:16px;min-width:0}.instansi-card h3{line-height:1.25}.instansi-card p{line-height:1.55}.instansi-icon{border-radius:13px}
.command-grid{gap:13px}.command-stat{border-radius:14px}.category-toolbar{grid-template-columns:1fr 1fr 2fr auto;gap:10px}.category-manager-grid{gap:12px}.category-manager-item{border-radius:13px}
.order-layout{gap:16px}.order-category-grid,.order-catalog{gap:10px}.order-category{border-radius:12px;padding:12px}.order-item{border-radius:12px;padding:12px}.order-cart{border-radius:12px}
/* Better scrolling areas */
.order-category-grid,.order-catalog,.master-editor,.modal-box{scrollbar-width:thin;scrollbar-color:#304553 transparent}
.order-category-grid::-webkit-scrollbar,.order-catalog::-webkit-scrollbar,.master-editor::-webkit-scrollbar,.modal-box::-webkit-scrollbar,.sidebar::-webkit-scrollbar{width:7px;height:7px}.order-category-grid::-webkit-scrollbar-thumb,.order-catalog::-webkit-scrollbar-thumb,.master-editor::-webkit-scrollbar-thumb,.modal-box::-webkit-scrollbar-thumb,.sidebar::-webkit-scrollbar-thumb{background:#304553;border-radius:20px}
/* Responsive cleanup */
@media(max-width:1100px){.main{padding:22px 20px 36px}.cards{grid-template-columns:repeat(2,1fr)}.category-toolbar{grid-template-columns:1fr 1fr}.instansi-grid{grid-template-columns:1fr}.order-layout{grid-template-columns:1fr}.order-category-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.sidebar{width:76px;padding:12px 8px}.brand span,.brand small,.nav button span{display:none}.brand{justify-content:center;padding:5px 4px 18px}.nav button{justify-content:center;padding:11px 8px}.main{margin-left:76px;width:calc(100% - 76px);padding:18px 14px 30px}.top{padding-top:8px}.top h1{font-size:20px}.cards{grid-template-columns:1fr 1fr}.grid2,.form-grid{grid-template-columns:1fr}.instansi-hero,.order-hero{padding:18px}.category-toolbar{grid-template-columns:1fr}.order-category-grid,.order-catalog{grid-template-columns:1fr}.command-grid{grid-template-columns:1fr 1fr}}
@media(max-width:480px){.main{padding:14px 10px 26px}.cards,.command-grid{grid-template-columns:1fr}.card{padding:15px}.top{margin-bottom:12px}.top p{max-width:70vw}.section{margin-top:17px}.section-head{align-items:flex-start;flex-direction:column}.section-head .btn{width:100%}.toolbar{flex-direction:column}.toolbar>*{width:100%!important;min-width:0}.instansi-card{grid-template-columns:auto 1fr}.instansi-card .btn{grid-column:1/-1;width:100%}.modal{padding:8px}.modal-box{padding:16px;border-radius:14px}.actions{flex-direction:column}.actions .btn{width:100%}}
</style>

