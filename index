function rpApplyTheme(color, save=true){
  const root=document.documentElement;
  root.style.setProperty('--rp-accent', color);
  root.style.setProperty('--rp-accent2', color);
  root.style.setProperty('--rp-blue', color);
  root.style.setProperty('--rp-gold', color);
  root.style.setProperty('--theme-accent', color);
  document.documentElement.style.setProperty('--user-theme-color', color);
  const p=document.getElementById('rpThemePreview');
  if(p) p.style.background=color;
  const label=document.getElementById('rpThemeValue');
  if(label) label.textContent=color;
  if(save) localStorage.setItem('rpThemeColor', color);
}
function rpRenderThemes(query=''){
  const grid=document.getElementById('rpThemeGrid');
  if(!grid)return;
  const q=query.trim().toLowerCase();
  let arr=RP_THEME_COLORS.map((c,i)=>({c,i}));
  if(q){
    arr=arr.filter(x=>x.c.toLowerCase().includes(q)||String(x.i+1).includes(q));
  }
  grid.innerHTML=arr.map(x=>`<button type="button" class="theme-swatch" title="Tema #${x.i+1} — ${x.c}" style="background:${x.c}" onclick="rpApplyTheme('${x.c}')"></button>`).join('');
  const count=document.getElementById('rpThemeCount');
  if(count) count.textContent=arr.length+' tema ditampilkan • total 1.500 tema';
}
function rpInitThemePicker(){
  const saved=localStorage.getItem('rpThemeColor');
  if(saved && RP_THEME_COLORS.includes(saved)) rpApplyTheme(saved,false);
  const search=document.getElementById('rpThemeSearch');
  if(search && !search.dataset.bound){
    search.dataset.bound='1';
    search.addEventListener('input',e=>rpRenderThemes(e.target.value));
  }
  rpRenderThemes();
}
document.addEventListener('DOMContentLoaded',rpInitThemePicker);
</script>

