<script id="netlify-compatibility-fix">
(function(){
  'use strict';

  function safeSessionGet(key){
    try { return sessionStorage.getItem(key); }
    catch(e){ return window.__RP_SESSION && window.__RP_SESSION[key] || null; }
  }
  function safeSessionSet(key,value){
    try { sessionStorage.setItem(key,value); }
    catch(e){
      window.__RP_SESSION = window.__RP_SESSION || {};
      window.__RP_SESSION[key] = String(value);
    }
  }
  function safeSessionRemove(key){
    try { sessionStorage.removeItem(key); } catch(e){}
    if(window.__RP_SESSION) delete window.__RP_SESSION[key];
  }

  // Keep the login overlay state working even in privacy-restricted browsers.
  window.addEventListener('DOMContentLoaded', function(){
    var loginBox = document.getElementById('login');
    if(!loginBox) return;

    if(safeSessionGet('siak_login') === '1'){
      loginBox.classList.remove('show');
    }

    var loginButton = loginBox.querySelector('button');
    if(loginButton && !loginButton.dataset.netlifyCompat){
      loginButton.dataset.netlifyCompat = '1';
      loginButton.addEventListener('click', function(ev){
        ev.preventDefault();
        try {
          if(typeof window.login === 'function') window.login();
        } catch(err) {
          console.error('Login error:', err);
        }
      });
    }
  });

  // Navigation fallback. Existing navigation remains untouched.
  document.addEventListener('click', function(ev){
    var btn = ev.target.closest && ev.target.closest('.nav button[data-page]');
    if(!btn) return;
    var page = btn.getAttribute('data-page');
    if(!page) return;
    try {
      if(typeof window.go === 'function') window.go(page);
    } catch(err) {
      console.error('Navigation error:', err);
    }
  }, true);

  // Ensure dynamically-created buttons are always buttons, never accidental submits.
  document.addEventListener('DOMContentLoaded', function(){
    document.querySelectorAll('button:not([type])').forEach(function(btn){
      btn.type = 'button';
    });
  });

  // Prevent placeholder links from navigating away from the SPA.
  document.addEventListener('click', function(ev){
    var a = ev.target.closest && ev.target.closest('a[href="#"]');
    if(a){
      ev.preventDefault();
    }
  }, true);

  // Expose safe session helpers for the existing app without changing its data model.
  window.__rpNetlifySession = {
    get: safeSessionGet,
    set: safeSessionSet,
    remove: safeSessionRemove
  };
})();
</script>

