function getLoginAccounts(){
  try{const saved=JSON.parse(localStorage.getItem('siak_rp_login_accounts')||'null');return saved&&typeof saved==='object'?saved:JSON.parse(JSON.stringify(ADMIN_ACCOUNTS));}
  catch(e){return JSON.parse(JSON.stringify(ADMIN_ACCOUNTS));}
}
function saveLoginAccounts(accounts){localStorage.setItem('siak_rp_login_accounts',JSON.stringify(accounts));}
function login(){
  const username=document.getElementById('loginUser').value.trim();
  const password=document.getElementById('loginPass').value;
  const account=getLoginAccounts()[username];
  if(account && account.password===password){
    document.getElementById('login').classList.remove('show');
    sessionStorage.setItem('siak_login','1');
    sessionStorage.setItem('siak_role',account.role);
    sessionStorage.setItem('siak_username',username);
    const userEl=document.querySelector('.top .user');
    if(userEl) userEl.innerHTML='👤 <b>'+account.role+'</b> • '+username;
    toast('Berhasil masuk sebagai '+account.role+'.');
  }else{
    alert('Username atau kata sandi salah.');
  }
}
function logout(){
  sessionStorage.removeItem('siak_login');
  sessionStorage.removeItem('siak_role');
  sessionStorage.removeItem('siak_username');
  document.getElementById('login').classList.add('show');
  const u=document.getElementById('loginUser'), p=document.getElementById('loginPass');
  if(u)u.value='';
  if(p)p.value='';
}

