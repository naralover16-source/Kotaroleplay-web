 const list=db.dok.filter(x=>!q||[x.no,x.jenis,x.pemilik,x.terbit,x.status].join(' ').toLowerCase().includes(q));
 document.getElementById('dokBody').innerHTML=list.length?list.map(x=>`<tr><td>${x.foto?`<img class="doc-thumb" src="${x.foto}" data-action="photo-dok" data-id="${x.id}" title="Lihat foto" alt="Foto dokumen" tabindex="0" role="button">`:'<div class="doc-thumb" style="display:grid;place-items:center">📄</div>'}</td><td><b>${esc(x.no)}</b></td><td>${esc(x.jenis)}</td><td>${esc(x.pemilik)}</td><td>${esc(x.terbit)}</td><td><span class="badge">${esc(x.status)}</span></td><td><button type="button" class="btn small" data-action="detail-dok" data-id="${x.id}">Detail</button> <button type="button" class="btn small secondary" data-action="edit-dok" data-id="${x.id}">Edit</button> <button type="button" class="btn small danger" data-action="delete-dok" data-id="${x.id}">Hapus</button></td></tr>`).join(''):'<tr><td colspan="7" class="empty">Belum ada dokumen.</td></tr>';
}

function filterServiceButtons(inputId,menuId){
 const q=(document.getElementById(inputId)?.value||'').trim().toLowerCase();
 const menu=document.getElementById(menuId);if(!menu)return;
 const buttons=[...menu.querySelectorAll('.gov-action')];let shown=0;
 buttons.forEach(b=>{const ok=!q||b.textContent.toLowerCase().includes(q);b.style.display=ok?'flex':'none';if(ok)shown++});
 let empty=menu.querySelector('.gov-empty');
 if(!shown&&q){if(!empty){empty=document.createElement('div');empty.className='gov-empty';empty.textContent='Layanan tidak ditemukan.';menu.appendChild(empty)}}else if(empty)empty.remove();
}

function openModal(title,content){
